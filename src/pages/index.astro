---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Gaudiano — Opciones de Landing">
  <main
    class="min-h-screen bg-[#1A1A1A] text-[#F5F2EB] flex flex-col items-center justify-center gap-8 p-12"
  >
    <h1 class="text-3xl tracking-widest uppercase font-light">
      Romina Gaudiano
    </h1>
    <p class="text-[#D2B48C] tracking-wider text-sm uppercase">
      Seleccioná una opción de landing
    </p>
    <nav class="flex flex-col gap-4 mt-4 text-center">
      <a
        href="/option-1"
        class="border border-[#F5F2EB]/30 px-10 py-4 tracking-widest text-sm uppercase hover:bg-[#F5F2EB] hover:text-[#1A1A1A] transition-colors"
      >
        Opción 1 — Editorial / Old Money
      </a>
      <a
        href="/option-2"
        class="border border-[#F5F2EB]/30 px-10 py-4 tracking-widest text-sm uppercase hover:bg-[#F5F2EB] hover:text-[#1A1A1A] transition-colors"
      >
        Opción 2 — Warm Minimalist / Organic
      </a>
      <a
        href="/option-3"
        class="border border-[#F5F2EB]/30 px-10 py-4 tracking-widest text-sm uppercase hover:bg-[#F5F2EB] hover:text-[#1A1A1A] transition-colors"
      >
        Opción 3 — Strategic / Modern Authority
      </a>
      <a
        href="/option-5"
        class="border border-[#D2B48C]/50 px-10 py-4 tracking-widest text-sm uppercase text-[#D2B48C] hover:bg-[#D2B48C] hover:text-[#1A1A1A] transition-colors"
      >
        Opción 5 — Fusión (cliente)
      </a>
      <a
        href="/option-6"
        class="border border-[#D2B48C] px-10 py-4 tracking-widest text-sm uppercase text-white bg-[#D2B48C]/20 hover:bg-[#D2B48C] hover:text-[#1A1A1A] transition-colors"
      >
        Opción 6 — Versión refinada
      </a>
    </nav>
  </main>
</BaseLayout>
