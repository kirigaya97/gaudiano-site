---
// Option 6 — Fusion + Customer Modifications
// (Duplicate of Option 5 with further refinements)
// Palette: option 4 (alabaster / navy #1B263B / cashmere #D7C9B4)
// Typography: option 1 (Playfair Display + Lora)
// Color combos in type: option 3 style (cashmere accents on dark)
// Layout structure: option 1 (editorial, 2-col hero, sep-lines)
// Counters: option 3 (animated stats strip)
// Pilares circles: option 4 (rounded-full numbered orbs with hover)
// Protocol hover: option 3 (row indent + bg on hover)
// Sobre mí: added horizontal slide-in movement
// Resultados boxes: enhanced contrast on hover
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Oasis de Claridad | Romina Gaudiano"
  fonts="Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lora:ital,wght@0,400;0,500;1,400"
>
  <style is:global>
    :root {
      --navy:    #1B263B;
      --cream:   #F5F2EB;
      --charcoal:#2A2A2A;
      --cashm:   #D7C9B4;
    }

    /* Scrollbar — whisper-thin, cashmere thumb fading at ends */
    ::-webkit-scrollbar              { width: 2px; }
    ::-webkit-scrollbar-track        { background: rgba(27,38,59,0.4); }
    ::-webkit-scrollbar-thumb        {
      background: linear-gradient(
        to bottom,
        transparent 0%,
        var(--cashm) 15%,
        var(--cashm) 85%,
        transparent 100%
      );
      border-radius: 0;
    }
    ::-webkit-scrollbar-thumb:hover  { background: var(--cream); }
    * { scrollbar-width: thin; scrollbar-color: var(--cashm) transparent; }
    ::selection { background: var(--cashm); color: var(--navy); }

    /* Hide default cursor globally for this page */
    .o6-page, .o6-page * { cursor: none !important; }

    /* Custom cursor */
    #o6-cursor-dot {
      position: fixed; top: 0; left: 0; z-index: 9999;
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--cashm);
      pointer-events: none;
      transform: translate(-50%, -50%);
      transition: opacity 0.3s;
    }
    #o6-cursor-ring {
      position: fixed; top: 0; left: 0; z-index: 9998;
      width: 36px; height: 36px; border-radius: 50%;
      border: 1px solid rgba(215,201,180,0.55);
      pointer-events: none;
      transform: translate(-50%, -50%);
      transition: width 0.3s, height 0.3s, border-color 0.3s, opacity 0.3s;
    }
    #o6-cursor-ring.hovered {
      width: 52px; height: 52px;
      border-color: var(--cashm);
    }

    /* CSS scroll-driven reveal */
    .o6-reveal {
      opacity: 0;
      transform: translateY(28px);
      animation: o6-reveal-up linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 38%;
    }
    @keyframes o6-reveal-up {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Sep-line expand */
    @keyframes o6-sep-grow {
      from { transform: scaleX(0); transform-origin: left; }
      to   { transform: scaleX(1); transform-origin: left; }
    }
    .o6-sep {
      animation: o6-sep-grow 1.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
      animation-timeline: view();
      animation-range: entry 0% entry 30%;
    }

    /* Hero entrance */
    @keyframes o6-hero-enter {
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes o6-img-reveal {
      from { opacity: 0; clip-path: inset(0 100% 0 0); }
      to   { opacity: 1; clip-path: inset(0 0% 0 0); }
    }
    @keyframes o6-rule-expand {
      from { width: 0; opacity: 0; }
      to   { opacity: 1; }
    }
    .o6-hero-item {
      opacity: 0;
      transform: translateY(20px);
      animation: o6-hero-enter 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    }
    .o6-hero-img {
      opacity: 0;
      animation: o6-img-reveal 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
      animation-delay: 0.1s;
    }
    .o6-hero-rule {
      opacity: 0;
      animation: o6-rule-expand 0.6s ease forwards;
      animation-delay: 1s;
    }

    /* Nav underline */
    .o6-nav-link { position: relative; }
    .o6-nav-link::after {
      content: ''; position: absolute; bottom: -2px; left: 0;
      width: 0; height: 1px; background: var(--cashm);
      transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .o6-nav-link:hover::after { width: 100%; }
    .o6-nav-link:hover { color: var(--cashm); }

    /* Hamburger Menu Overlay */
    #o6-menu-toggle:checked ~ #o6-menu-overlay { 
      opacity: 1; pointer-events: auto; 
    }
    #o6-menu-toggle:checked ~ #o6-menu-overlay .o6-menu-content {
      transform: translateY(0);
    }
    .o6-menu-link {
      font-family: 'Playfair Display', serif;
      transition: color 0.4s ease, transform 0.4s ease;
      display: block;
    }
    .o6-menu-link:hover {
      color: var(--cashm);
      transform: translateX(10px);
    }

    /* Dynamic Pilares Section Hover using :has() */
    #o6-pilares {
      transition: background 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94), color 0.7s ease;
      --section-bg: var(--navy);
      --section-text: var(--cream);
      --pilar-circle-bg: var(--navy);
      --pilar-circle-text: var(--cashm);
      --pilar-line-color: rgba(245, 242, 235, 0.07);
      background: var(--section-bg);
      color: var(--section-text);
    }

    #o6-pilares:has(.o6-pilar-card:nth-child(2):hover) {
      --section-bg: var(--charcoal);
      --section-text: var(--cashm);
      --pilar-circle-bg: var(--charcoal);
      --pilar-circle-text: var(--cream);
      --pilar-line-color: rgba(215, 201, 180, 0.1);
    }
    #o6-pilares:has(.o6-pilar-card:nth-child(3):hover) {
      --section-bg: var(--cashm);
      --section-text: var(--navy);
      --pilar-circle-bg: var(--navy);
      --pilar-circle-text: var(--cream);
      --pilar-line-color: rgba(27, 38, 59, 0.1);
    }
    #o6-pilares:has(.o6-pilar-card:nth-child(4):hover) {
      --section-bg: var(--cream);
      --section-text: var(--charcoal);
      --pilar-circle-bg: var(--navy);
      --pilar-circle-text: var(--cashm);
      --pilar-line-color: rgba(27, 38, 59, 0.08);
    }

    .o6-pilar-circle { background: var(--pilar-circle-bg) !important; color: var(--pilar-circle-text) !important; }
    #o6-pilares-line { background: var(--pilar-line-color) !important; }

    /* Fix contrasts */
    .o6-emphasis { color: var(--cream) !important; font-weight: 700; }
    .o6-contrast-heading { font-weight: 700; color: var(--navy) !important; }
    
    /* Stats */
    .o6-stat-num {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: clamp(3.5rem, 6vw, 5.5rem);
      line-height: 1;
      color: var(--navy);
    }

    /* Protocolo rows — option 3 hover */
    .o6-offer-row {
      transition: background 0.4s ease, padding-left 0.4s ease;
    }
    .o6-offer-row:hover {
      padding-left: 1.5rem;
      background: rgba(27, 38, 59, 0.04);
    }

    /* Pilares circles — option 4 orb hover */
    .o6-pilar-card { transition: transform 0.5s ease; cursor: default; }
    .o6-pilar-card:hover { transform: translateY(-6px); }
    .o6-pilar-circle {
      transition: background 0.5s ease, color 0.5s ease, transform 0.4s ease, box-shadow 0.4s ease;
    }
    .o6-pilar-card:hover .o6-pilar-circle {
      background: var(--cashm);
      color: var(--navy);
      transform: scale(1.1);
      box-shadow: 0 0 36px rgba(215, 201, 180, 0.28);
    }
    .o6-pilar-desc { transition: opacity 0.4s ease; }
    .o6-pilar-card:hover .o6-pilar-desc { opacity: 1; }

    /* Hero image zoom on hover */
    .o6-hero-img img {
      transition: transform 1.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .o6-hero-img:hover img { transform: scale(1.06); }

    /* Sobre mí — slide-in from sides */
    .o6-sobre-left {
      opacity: 0;
      transform: translateX(-40px);
      animation: o6-slide-left linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 48%;
    }
    .o6-sobre-right {
      opacity: 0;
      transform: translateX(40px);
      animation: o6-slide-right linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 48%;
    }
    @keyframes o6-slide-left {
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes o6-slide-right {
      to { opacity: 1; transform: translateX(0); }
    }

    /* Resultados boxes — contrast hover */
    .o6-resultado-box {
      border: 1px solid rgba(215, 201, 180, 0.18);
      transition: background 0.35s ease, border-color 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
      cursor: default;
    }
    .o6-resultado-box:hover {
      background: rgba(215, 201, 180, 0.13);
      border-color: var(--cashm);
      transform: translateY(-5px);
      box-shadow: 0 8px 28px rgba(215, 201, 180, 0.12);
    }
    .o6-resultado-text { transition: color 0.35s ease; }
    .o6-resultado-box:hover .o6-resultado-text {
      color: var(--cashm);
      font-style: italic;
    }
    .o6-resultado-box .o6-resultado-line {
      transition: width 0.35s ease, opacity 0.35s ease;
    }
    .o6-resultado-box:hover .o6-resultado-line {
      width: 2rem;
      opacity: 0.9;
    }
  </style>

  <!-- Custom cursor elements (desktop only) -->
  <div id="o6-cursor-dot" class="hidden md:block"></div>
  <div id="o6-cursor-ring" class="hidden md:block"></div>

  <div class="o6-page overflow-x-hidden max-w-[100vw]" style="background: var(--navy); color: var(--cream); min-height: 100vh; font-family: 'Lora', serif;">

    <!-- Hamburger Toggle Input (Hidden) & Overlay -->
    <input type="checkbox" id="o6-menu-toggle" class="hidden peer" />
    <div id="o6-menu-overlay" class="fixed inset-0 w-full h-full bg-[#2A2A2A]/98 z-[120] opacity-0 pointer-events-none transition-opacity duration-500 flex items-center justify-center">
      <!-- Close Button (X) -->
      <label for="o6-menu-toggle" class="absolute top-8 left-8 md:top-12 md:left-12 text-cream/30 hover:text-cashm text-4xl md:text-5xl cursor-pointer transition-colors z-[130] font-light">
        ×
      </label>

      <div class="o6-menu-content transform -translate-y-10 transition-transform duration-700 flex flex-col items-center gap-8 md:gap-10 text-center px-6">
        <a href="/option-6"  class="o6-menu-link text-3xl md:text-4xl text-cream tracking-tight">Home</a>
        <a href="#mentoria"  class="o6-menu-link text-3xl md:text-4xl text-cream tracking-tight">Reprogramación mental para traders: ¿Por qué?</a>
        <a href="#protocolo" class="o6-menu-link text-3xl md:text-4xl text-cream tracking-tight">Formato de la Mentoría</a>
        <a href="#sobre-mi"  class="o6-menu-link text-3xl md:text-4xl text-cream tracking-tight">Sobre Mí</a>
        
        <label for="o6-menu-toggle" class="mt-8 text-[10px] tracking-[0.4em] uppercase text-cashm/50 cursor-pointer hover:text-cream transition-colors">
          Cerrar Menú
        </label>
      </div>
    </div>

    <!-- ── Nav ───────────────────────────────────────────── -->
    <nav class="fixed top-0 left-0 right-0 z-[100] flex justify-between items-center px-6 md:px-10 py-5 md:py-6 transition-shadow duration-500"
         style="background: rgba(27,38,59,0.93); backdrop-filter: blur(8px);">

      <div class="flex items-center gap-4">
        <!-- Hamburger Icon -->
        <label for="o6-menu-toggle" class="cursor-pointer group flex flex-col gap-1.5 z-[110] relative">
          <span class="w-6 h-px bg-cream transition-all group-hover:bg-cashm"></span>
          <span class="w-6 h-px bg-cream transition-all group-hover:bg-cashm"></span>
          <span class="w-4 h-px bg-cream transition-all group-hover:bg-cashm"></span>
        </label>
        <span class="text-xs tracking-[0.32em] uppercase"
              style="color: var(--cashm); font-family: 'Playfair Display', serif;">
          Romina Gaudiano
        </span>
      </div>

      <a href="#contacto"
         class="text-[10px] md:text-xs tracking-[0.2em] md:tracking-[0.25em] uppercase px-4 md:px-6 py-2 md:py-2.5 transition-all duration-300"
         style="background: var(--cashm); color: var(--navy);"
         onmouseover="this.style.background='var(--cream)'"
         onmouseout="this.style.background='var(--cashm)'">
        Aplicá Acá
      </a>
    </nav>

    <!-- ── Hero ──────────────────────────────────────────── -->
    <!--
      SECTION LAYOUT NOTES:
      - 'relative'        → required so the mobile portrait (absolute) is positioned relative to this section
      - 'overflow-hidden' → clips the mobile portrait that intentionally bleeds past the right edge
      - 'grid md:grid-cols-2' → 2-column grid on desktop, single stacked column on mobile
      - 'min-height: 100vh' → always fills the full viewport height
    -->
    <section class="relative grid md:grid-cols-2 overflow-hidden" style="min-height: 100vh;">

      <!--
        ═══════════════════════════════════════════════════════════
        DESKTOP PORTRAIT — Left column of the 2-col grid
        - 'hidden md:block' → only rendered on md+ screens (≥768px)
        - Gradient goes transparent → navy (left to right) to blend into the text column on the right
        - No horizontal mirror: she faces right, toward the text content
        ═══════════════════════════════════════════════════════════
      -->
      <div class="relative hidden md:block o6-hero-img overflow-hidden">
        <img src="/gaudiano1.jpg" alt="Romina Gaudiano"
             class="absolute inset-0 w-full h-full object-cover object-top"
             style="filter: grayscale(25%) contrast(1.05);" />
        <!-- Gradient: covers the right edge of the image to blend into the text column -->
        <div class="absolute inset-0"
             style="background: linear-gradient(to right, transparent, var(--navy));"></div>
      </div>

      <!--
        ═══════════════════════════════════════════════════════════
        MOBILE PORTRAIT — Cinematic right-side overlay
        - 'absolute md:hidden' → only on mobile; removed from grid flow so text overlaps it
        - 'inset-y-0' → fills the full section height from top to bottom
        - 'z-0' → renders behind the content column (which is z-10)

        PROPORTIONS (adjust these to reframe the portrait):
        • width: 80vw     → total image div width. Increase to show more of her body.
        • right: -20vw    → shifts the div 20vw past the right viewport edge.
                            Result: 80vw - 20vw = 60vw visible (~3/4 on screen, 1/4 off-screen right).
                            Make more negative to bleed more off-screen.
        ═══════════════════════════════════════════════════════════
      -->
      <div class="absolute md:hidden inset-y-0 z-0"
           style="width: 80vw; right: -20vw;">

        <!--
          Portrait image:
          - 'transform: scaleX(-1)' → mirrors horizontally so she faces LEFT (toward the text)
          - 'object-top'            → anchors to the top (face/upper body stays in frame)
          - Same grayscale/contrast filter as the desktop version for visual consistency
          Note: alt="" intentional — this is decorative/duplicate, screen readers use the desktop version
        -->
        <img src="/gaudiano1.jpg" alt=""
             class="absolute inset-0 w-full h-full object-cover object-top"
             style="filter: grayscale(25%) contrast(1.05); transform: scaleX(-1);" />

        <!--
          Left gradient overlay:
          - Starts at full navy (var(--navy)) on the LEFT edge of this div (~40vw from screen left)
          - Fades through a semi-transparent mid-stop at 55%
          - Reaches transparent at 80%, letting the portrait come through on the right

          HOW TO ADJUST:
          • Move "55%" left (e.g. 40%) → shows more of her face earlier
          • Move "55%" right (e.g. 70%) → stronger cover, less face visible through gradient
          • Change the mid rgba() alpha (0.4) → lower = more see-through in the middle
        -->
        <div class="absolute inset-0"
             style="background: linear-gradient(to right, var(--navy) 0%, rgba(27,38,59,0.7) 95%, transparent 80%);"></div>
      </div>

      <!--
        ═══════════════════════════════════════════════════════════
        CONTENT COLUMN — Text, headline, CTA
        - 'relative z-10' → ensures text renders ABOVE the mobile absolute portrait (z-0)
        - On mobile: full-width, content anchored to the bottom (justify-end)
        - On desktop: right column of the 2-col grid
        ═══════════════════════════════════════════════════════════
      -->
      <div class="flex flex-col justify-end pb-24 md:pb-36 px-6 md:px-16 pt-20 md:pt-24 relative z-10">
        <div class="max-w-4xl">
          <p class="o6-hero-item text-xs tracking-[0.4em] uppercase mb-10"
             style="color: var(--cashm); animation-delay: 0.35s;">
            Mentoría 1:1 – CryptoMind Pro Elite
          </p>
          <h1 class="o6-hero-item text-[1.6rem] leading-tight md:text-[3rem] lg:text-[4.8rem] md:leading-[1.05] mb-8 md:mb-12"
              style="font-family: 'Playfair Display', serif; animation-delay: 0.6s;">
            El poder de una mente clara<br />
            <em style="color: var(--cashm);">para invertir mejor.</em>
          </h1>
          <div class="o6-hero-rule w-16 h-px mb-12"
               style="background: rgba(245,242,235,0.18);"></div>
          <p class="o6-hero-item text-lg leading-relaxed max-w-md mb-4"
             style="color: rgba(245,242,235,0.7); animation-delay: 1.05s;">
            Reprogramación Mental y Cambio de Hábitos para Traders e Inversores.
          </p>
          <p class="o6-hero-item text-base leading-relaxed max-w-md mb-16"
             style="color: rgba(245,242,235,0.45); animation-delay: 1.1s;">
            Diseñada para quienes buscan optimizar su rendimiento interno, sostener claridad emocional y tomar decisiones conscientes bajo presión.
          </p>
          <a href="#contacto"
             class="o6-hero-item inline-block text-xs tracking-[0.3em] uppercase px-10 py-4 transition-all duration-500"
             style="border: 1px solid rgba(245,242,235,0.2); animation-delay: 1.25s;"
             onmouseover="this.style.background='var(--cream)'; this.style.color='var(--navy)'"
             onmouseout="this.style.background='transparent'; this.style.color='var(--cream)'">
            Aplicá Acá
          </a>
        </div>
      </div>

    </section>


    <!-- ── New "Impacto" Section ──────────────────────────── -->
    <section class="relative py-16 md:py-32 px-6 md:px-20 o6-reveal overflow-hidden" style="color: var(--cream);">
      <!-- bg image + overlay -->
      <div class="absolute inset-0 z-0">
        <img src="/impacto-bg.png" alt="" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-[#2A2A2A]/96"></div>
      </div>

      <div class="relative z-10 max-w-6xl mx-auto grid md:grid-cols-[1fr_1.4fr] gap-12 md:gap-24 items-center">
        
        <!-- Left: Image -->
        <div class="relative group">
          <div class="absolute -inset-2 md:-inset-4 border border-cashm/20 translate-x-0 translate-y-0 md:translate-x-2 md:translate-y-2 transition-transform group-hover:translate-x-0 group-hover:translate-y-0 duration-700"></div>
          <div class="overflow-hidden aspect-[4/3] relative z-10 shadow-2xl">
            <img src="/impacto-trading.png" alt="Mentalidad en el trading" 
                 class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
          </div>
        </div>

        <!-- Right: Text -->
        <div>
          <h2 class="text-2xl md:text-4xl lg:text-5xl leading-tight" style="font-family: 'Playfair Display', serif;">
            ¿Te sentís como un auto <br class="hidden md:block"/> 
            <em>de carreras sin frenos?</em>
          </h2>
          <h2 class="text-2xl md:text-4xl lg:text-5xl leading-tight mt-8" style="font-family: 'Playfair Display', serif;">
            ¿Cuál es el costo emocional <br class="hidden md:block"/> 
            <em>de tu éxito financiero?</em>
          </h2>
          <p class="text-lg italic mt-10 md:mt-12" style="color: var(--cashm); font-family: 'Lora', serif;">
            La verdadera libertad está en la claridad mental.
          </p>
        </div>

      </div>
    </section>

    <div class="o6-sep mx-4 md:mx-20"
         style="border-top: 1px solid rgba(245,242,235,0.08);"></div>


    <!-- ── Stats strip (option 3 animated counters) ───────── -->
    <div style="background: var(--cashm); padding: 3rem 1.5rem;">
      <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
        <div class="py-4 sm:py-0">
          <p class="o6-stat-num" data-count="4500" data-suffix="+">4500+</p>
          <p class="text-xs tracking-[0.3em] uppercase mt-3"
             style="color: rgba(27,38,59,0.6); font-family: 'Lora', serif;">Procesos de transformación</p>
        </div>
        <div class="py-4 sm:py-0"
             style="border-left: 1px solid rgba(27,38,59,0.15); border-right: 1px solid rgba(27,38,59,0.15);">
          <p class="o6-stat-num" data-count="12">12</p>
          <p class="text-xs tracking-[0.3em] uppercase mt-3"
             style="color: rgba(27,38,59,0.6); font-family: 'Lora', serif;">Sesiones personalizadas</p>
        </div>
        <div class="py-4 sm:py-0">
          <p class="o6-stat-num" data-count="3">3</p>
          <p class="text-xs tracking-[0.3em] uppercase mt-3"
             style="color: rgba(27,38,59,0.6); font-family: 'Lora', serif;">Meses de proceso</p>
        </div>
      </div>
    </div>

    <div class="o6-sep mx-4 md:mx-20"
         style="border-top: 1px solid rgba(245,242,235,0.08);"></div>

    <!-- ── ¿Por qué? ──────────────────────────────────────── -->
    <section id="mentoria" class="py-16 md:py-32 px-6 md:px-20 o6-reveal">
      <div class="max-w-6xl mx-auto grid md:grid-cols-[1.2fr_1.8fr] gap-12 md:gap-24 items-center">
        
        <div>
          <div class="mb-8">
            <p class="text-xs tracking-[0.4em] uppercase mb-4" style="color: var(--cashm);">La pregunta clave</p>
            <div class="w-12 h-px" style="background: var(--cashm);"></div>
          </div>
          <div class="relative group mx-2 md:mx-0 mt-4 md:mt-0">
            <div class="absolute -inset-2 md:-inset-4 border border-cashm/20 translate-x-0 translate-y-0 md:translate-x-2 md:translate-y-2 transition-transform group-hover:translate-x-0 group-hover:translate-y-0 duration-700"></div>
            <div class="overflow-hidden aspect-[4/5] relative z-10 shadow-2xl">
              <img src="/trader-analysis.png" alt="Análisis de trading profesional" 
                   class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
