  <script>
    // ── Custom cursor (desktop only) ────────────────────────
    if (window.matchMedia('(hover: hover)').matches) {
      const dot  = document.getElementById('o6-cursor-dot')  as HTMLElement;
      const ring = document.getElementById('o6-cursor-ring') as HTMLElement;

      if (dot && ring) {
        // Dot and Ring follow mouse instantly (no lag)
        document.addEventListener('mousemove', e => {
          const mx = e.clientX; 
          const my = e.clientY;
          
          dot.style.left = mx + 'px';
          dot.style.top  = my + 'px';
          
          ring.style.left = mx + 'px';
          ring.style.top  = my + 'px';
        }, { passive: true });

        // Hover state on interactables
        document.querySelectorAll('a, button, label').forEach(el => {
          el.addEventListener('mouseenter', () => ring.classList.add('hovered'));
          el.addEventListener('mouseleave', () => ring.classList.remove('hovered'));
        });
      }
    }

    // ── Menu auto-close on link click ───────────────────────
    const menuToggle = document.getElementById('o6-menu-toggle') as HTMLInputElement;
    const menuLinks  = document.querySelectorAll('.o6-menu-link');
    menuLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (menuToggle) menuToggle.checked = false;
      });
    });

    // ── Counter animation (option 3) ────────────────────────
    const counters = document.querySelectorAll('[data-count]');
    const counterObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.count ?? '0');
        const suffix = el.dataset.suffix ?? '';
        const duration = 1600;
        let startTime: number | null = null;
        const tick = (timestamp: number) => {
          if (!startTime) startTime = timestamp;
          const progress = Math.min((timestamp - startTime) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        counterObserver.unobserve(el);
      });
    }, { threshold: 0.6 });
    counters.forEach(c => counterObserver.observe(c));
  </script>

