---
// Option 5 — Fusion
// Palette: option 4 (alabaster / navy #1B263B / cashmere #D7C9B4)
// Typography: option 1 (Playfair Display + Lora)
// Color combos in type: option 3 style (cashmere accents on dark)
// Layout structure: option 1 (editorial, 2-col hero, sep-lines)
// Counters: option 3 (animated stats strip)
// Pilares circles: option 4 (rounded-full numbered orbs with hover)
// Protocol hover: option 3 (row indent + bg on hover)
// Sobre mí: added horizontal slide-in movement
// Resultados boxes: enhanced contrast on hover
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Oasis de Claridad | Romina Gaudiano"
  fonts="Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lora:ital,wght@0,400;0,500;1,400"
>
  <style is:global>
    :root {
      --navy:    #1B263B;
      --cream:   #F5F2EB;
      --charcoal:#2A2A2A;
      --cashm:   #D7C9B4;
    }

    /* Scrollbar — whisper-thin, cashmere thumb fading at ends */
    ::-webkit-scrollbar              { width: 2px; }
    ::-webkit-scrollbar-track        { background: rgba(27,38,59,0.4); }
    ::-webkit-scrollbar-thumb        {
      background: linear-gradient(
        to bottom,
        transparent 0%,
        var(--cashm) 15%,
        var(--cashm) 85%,
        transparent 100%
      );
      border-radius: 0;
    }
    ::-webkit-scrollbar-thumb:hover  { background: var(--cream); }
    * { scrollbar-width: thin; scrollbar-color: var(--cashm) transparent; }
    ::selection { background: var(--cashm); color: var(--navy); }

    /* Hide default cursor globally for this page */
    .o5-page, .o5-page * { cursor: none !important; }

    /* Custom cursor */
    #o5-cursor-dot {
      position: fixed; top: 0; left: 0; z-index: 9999;
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--cashm);
      pointer-events: none;
      transform: translate(-50%, -50%);
      transition: opacity 0.3s;
    }
    #o5-cursor-ring {
      position: fixed; top: 0; left: 0; z-index: 9998;
      width: 36px; height: 36px; border-radius: 50%;
      border: 1px solid rgba(215,201,180,0.55);
      pointer-events: none;
      transform: translate(-50%, -50%);
      transition: width 0.3s, height 0.3s, border-color 0.3s, opacity 0.3s;
    }
    #o5-cursor-ring.hovered {
      width: 52px; height: 52px;
      border-color: var(--cashm);
    }

    /* CSS scroll-driven reveal */
    .o5-reveal {
      opacity: 0;
      transform: translateY(28px);
      animation: o5-reveal-up linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 38%;
    }
    @keyframes o5-reveal-up {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Sep-line expand */
    @keyframes o5-sep-grow {
      from { transform: scaleX(0); transform-origin: left; }
      to   { transform: scaleX(1); transform-origin: left; }
    }
    .o5-sep {
      animation: o5-sep-grow 1.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
      animation-timeline: view();
      animation-range: entry 0% entry 30%;
    }

    /* Hero entrance */
    @keyframes o5-hero-enter {
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes o5-img-reveal {
      from { opacity: 0; clip-path: inset(0 100% 0 0); }
      to   { opacity: 1; clip-path: inset(0 0% 0 0); }
    }
    @keyframes o5-rule-expand {
      from { width: 0; opacity: 0; }
      to   { opacity: 1; }
    }
    .o5-hero-item {
      opacity: 0;
      transform: translateY(20px);
      animation: o5-hero-enter 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    }
    .o5-hero-img {
      opacity: 0;
      animation: o5-img-reveal 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
      animation-delay: 0.1s;
    }
    .o5-hero-rule {
      opacity: 0;
      animation: o5-rule-expand 0.6s ease forwards;
      animation-delay: 1s;
    }

    /* Nav underline */
    .o5-nav-link { position: relative; }
    .o5-nav-link::after {
      content: ''; position: absolute; bottom: -2px; left: 0;
      width: 0; height: 1px; background: var(--cashm);
      transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .o5-nav-link:hover::after { width: 100%; }
    .o5-nav-link:hover { color: var(--cashm); }

    /* Stats */
    .o5-stat-num {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: clamp(3.5rem, 6vw, 5.5rem);
      line-height: 1;
      color: var(--navy);
    }

    /* Protocolo rows — option 3 hover */
    .o5-offer-row {
      transition: background 0.4s ease, padding-left 0.4s ease;
    }
    .o5-offer-row:hover {
      padding-left: 1.5rem;
      background: rgba(27, 38, 59, 0.04);
    }

    /* Pilares circles — option 4 orb hover */
    .o5-pilar-card { transition: transform 0.5s ease; cursor: default; }
    .o5-pilar-card:hover { transform: translateY(-6px); }
    .o5-pilar-circle {
      transition: background 0.5s ease, color 0.5s ease, transform 0.4s ease, box-shadow 0.4s ease;
    }
    .o5-pilar-card:hover .o5-pilar-circle {
      background: var(--cashm);
      color: var(--navy);
      transform: scale(1.1);
      box-shadow: 0 0 36px rgba(215, 201, 180, 0.28);
    }
    .o5-pilar-desc { transition: color 0.4s ease; }
    .o5-pilar-card:hover .o5-pilar-desc { color: rgba(245, 242, 235, 0.85); }

    /* Hero image zoom on hover */
    .o5-hero-img img {
      transition: transform 1.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .o5-hero-img:hover img { transform: scale(1.06); }

    /* Sobre mí — slide-in from sides */
    .o5-sobre-left {
      opacity: 0;
      transform: translateX(-40px);
      animation: o5-slide-left linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 48%;
    }
    .o5-sobre-right {
      opacity: 0;
      transform: translateX(40px);
      animation: o5-slide-right linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 48%;
    }
    @keyframes o5-slide-left {
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes o5-slide-right {
      to { opacity: 1; transform: translateX(0); }
    }

    /* Resultados boxes — contrast hover */
    .o5-resultado-box {
      border: 1px solid rgba(215, 201, 180, 0.18);
      transition: background 0.35s ease, border-color 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
      cursor: default;
    }
    .o5-resultado-box:hover {
      background: rgba(215, 201, 180, 0.13);
      border-color: var(--cashm);
      transform: translateY(-5px);
      box-shadow: 0 8px 28px rgba(215, 201, 180, 0.12);
    }
    .o5-resultado-text { transition: color 0.35s ease; }
    .o5-resultado-box:hover .o5-resultado-text {
      color: var(--cashm);
      font-style: italic;
    }
    .o5-resultado-box .o5-resultado-line {
      transition: width 0.35s ease, opacity 0.35s ease;
    }
    .o5-resultado-box:hover .o5-resultado-line {
      width: 2rem;
      opacity: 0.9;
    }
  </style>

  <!-- Custom cursor elements (desktop only) -->
  <div id="o5-cursor-dot" class="hidden md:block"></div>
  <div id="o5-cursor-ring" class="hidden md:block"></div>

  <div class="o5-page" style="background: var(--navy); color: var(--cream); min-height: 100vh; font-family: 'Lora', serif;">

    <!-- ── Nav ───────────────────────────────────────────── -->
    <nav class="fixed top-0 left-0 right-0 z-50 flex justify-between items-center px-4 md:px-10 py-5 md:py-6 transition-shadow duration-500"
         style="background: rgba(27,38,59,0.93); backdrop-filter: blur(8px);">
      <span class="text-xs tracking-[0.32em] uppercase"
            style="color: var(--cashm); font-family: 'Playfair Display', serif;">
        Romina Gaudiano
      </span>
      <div class="hidden md:flex items-center gap-8">
        <a href="#mentoria"  class="o5-nav-link text-xs tracking-[0.25em] uppercase transition-colors duration-300" style="color: rgba(245,242,235,0.5);">Mentoría</a>
        <a href="#sobre-mi"  class="o5-nav-link text-xs tracking-[0.25em] uppercase transition-colors duration-300" style="color: rgba(245,242,235,0.5);">Sobre Mí</a>
        <a href="#protocolo" class="o5-nav-link text-xs tracking-[0.25em] uppercase transition-colors duration-300" style="color: rgba(245,242,235,0.5);">Protocolo</a>
      </div>
      <a href="#contacto"
         class="text-xs tracking-[0.25em] uppercase px-6 py-2.5 transition-all duration-300"
         style="background: var(--cashm); color: var(--navy);"
         onmouseover="this.style.background='var(--cream)'"
         onmouseout="this.style.background='var(--cashm)'">
        Aplicá Acá
      </a>
    </nav>

    <!-- ── Hero ──────────────────────────────────────────── -->
    <section class="grid md:grid-cols-2" style="min-height: 100vh;">

      <div class="relative hidden md:block o5-hero-img overflow-hidden">
        <img src="/gaudiano1.jpg" alt="Romina Gaudiano"
             class="absolute inset-0 w-full h-full object-cover object-top"
             style="filter: grayscale(25%) contrast(1.05);" />
        <div class="absolute inset-0"
             style="background: linear-gradient(to right, transparent, var(--navy));"></div>
      </div>

      <div class="flex flex-col justify-end pb-24 md:pb-36 px-6 md:px-16 pt-20 md:pt-24">
        <div class="max-w-4xl">
          <p class="o5-hero-item text-xs tracking-[0.4em] uppercase mb-10"
             style="color: var(--cashm); animation-delay: 0.35s;">
            Mentoría 1:1 – CryptoMind Pro Elite
          </p>
          <h1 class="o5-hero-item text-4xl md:text-6xl lg:text-8xl leading-[1.05] mb-8 md:mb-12"
              style="font-family: 'Playfair Display', serif; animation-delay: 0.6s;">
            El poder de una<br />
            <em style="color: var(--cashm);">mente clara.</em>
          </h1>
          <div class="o5-hero-rule w-16 h-px mb-12"
               style="background: rgba(245,242,235,0.18);"></div>
          <p class="o5-hero-item text-lg leading-relaxed max-w-md mb-4"
             style="color: rgba(245,242,235,0.7); animation-delay: 1.05s;">
            Reprogramación Mental y Cambio de Hábitos para Traders e Inversores.
          </p>
          <p class="o5-hero-item text-base leading-relaxed max-w-md mb-16"
             style="color: rgba(245,242,235,0.45); animation-delay: 1.1s;">
            Diseñada para quienes buscan optimizar su rendimiento interno, sostener claridad emocional y tomar decisiones conscientes bajo presión.
          </p>
          <a href="#contacto"
             class="o5-hero-item inline-block text-xs tracking-[0.3em] uppercase px-10 py-4 transition-all duration-500"
             style="border: 1px solid rgba(245,242,235,0.2); animation-delay: 1.25s;"
             onmouseover="this.style.background='var(--cream)'; this.style.color='var(--navy)'"
             onmouseout="this.style.background='transparent'; this.style.color='var(--cream)'">
            Aplicar Acá
          </a>
        </div>
      </div>

    </section>

    <!-- ── Stats strip (option 3 animated counters) ───────── -->
    <div style="background: var(--cashm); padding: 3rem 1.5rem;">
      <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
        <div class="py-4 sm:py-0">
          <p class="o5-stat-num" data-count="4500" data-suffix="+">4500+</p>
          <p class="text-xs tracking-[0.3em] uppercase mt-3"
             style="color: rgba(27,38,59,0.6); font-family: 'Lora', serif;">Procesos de transformación</p>
        </div>
        <div class="py-4 sm:py-0"
             style="border-left: 1px solid rgba(27,38,59,0.15); border-right: 1px solid rgba(27,38,59,0.15);">
          <p class="o5-stat-num" data-count="12">12</p>
          <p class="text-xs tracking-[0.3em] uppercase mt-3"
             style="color: rgba(27,38,59,0.6); font-family: 'Lora', serif;">Sesiones personalizadas</p>
        </div>
        <div class="py-4 sm:py-0">
          <p class="o5-stat-num" data-count="3">3</p>
          <p class="text-xs tracking-[0.3em] uppercase mt-3"
             style="color: rgba(27,38,59,0.6); font-family: 'Lora', serif;">Meses de proceso</p>
        </div>
      </div>
    </div>

    <div class="o5-sep mx-4 md:mx-20"
         style="border-top: 1px solid rgba(245,242,235,0.08);"></div>

    <!-- ── ¿Por qué? ──────────────────────────────────────── -->
    <section id="mentoria" class="py-16 md:py-32 px-4 md:px-20 o5-reveal">
      <div class="max-w-5xl grid md:grid-cols-[1fr_2fr] gap-20 items-start">
        <div>
          <p class="text-xs tracking-[0.4em] uppercase mb-4" style="color: var(--cashm);">La pregunta clave</p>
          <div class="w-8 h-px" style="background: var(--cashm);"></div>
        </div>
        <div>
          <h2 class="text-4xl md:text-5xl leading-tight mb-10"
              style="font-family: 'Playfair Display', serif;">
            ¿Por qué una mentoría de<br />
            <em style="color: var(--cashm);">reprogramación mental?</em>
          </h2>
          <p class="leading-loose text-lg mb-6" style="color: rgba(245,242,235,0.7);">
            Porque los hábitos que determinan tus decisiones económicas y financieras no son conscientes, no se corrigen con fuerza de voluntad, y se sostienen en patrones neuronales automáticos.
          </p>
          <p class="leading-loose text-lg mb-6" style="color: rgba(245,242,235,0.7);">
            Las neurociencias demuestran que la toma de decisiones financieras se activa desde el subconsciente, <em>incluso en personas altamente racionales.</em>
          </p>
          <p class="leading-loose text-base" style="color: rgba(245,242,235,0.45);">
            Esta mentoría no es para aprender a operar. Trabaja donde realmente se define el resultado: tu respuesta interna frente al riesgo, la ganancia y la pérdida.
          </p>
        </div>
      </div>
    </section>

    <div class="o5-sep mx-4 md:mx-20"
         style="border-top: 1px solid rgba(245,242,235,0.08);"></div>

    <!-- ── Protocolo (option 3 hover rows + Playfair + opt-4 palette) ── -->
    <section id="protocolo" class="py-16 md:py-32 px-4 md:px-20"
             style="background: var(--cream); color: var(--charcoal);">
      <div class="max-w-5xl mx-auto">

        <div class="mb-16 o5-reveal">
          <p class="text-xs tracking-[0.4em] uppercase mb-4" style="color: var(--cashm);">Protocolo</p>
          <h2 class="text-4xl md:text-6xl leading-tight"
              style="font-family: 'Playfair Display', serif; color: var(--navy); font-weight: 700;">
            El trabajo.
          </h2>
        </div>

        <div class="o5-offer-row border-t py-8 md:py-12 grid grid-cols-[40px_1fr] md:grid-cols-[80px_1fr_auto] gap-4 md:gap-8 items-start md:items-center o5-reveal"
             style="border-color: rgba(27,38,59,0.1);">
          <p class="text-4xl md:text-6xl"
             style="font-family: 'Playfair Display', serif; color: rgba(27,38,59,0.07); line-height: 1; font-weight: 700;">01</p>
          <div>
            <h3 class="text-xl md:text-3xl mb-3 md:mb-4"
                style="font-family: 'Playfair Display', serif; color: var(--navy);">
              Reprogramación Mental Subconsciente
            </h3>
            <p class="leading-relaxed text-sm md:text-base" style="color: rgba(42,42,42,0.55);">
              No analizamos el síntoma. Reprogramamos el patrón que lo genera y lo cambiamos de raíz.
            </p>
          </div>
          <a href="#contacto"
             class="hidden md:block whitespace-nowrap text-xs tracking-[0.2em] uppercase px-6 py-4 transition-colors duration-300"
             style="background: var(--navy); color: var(--cream); margin-right: 1.5rem;"
             onmouseover="this.style.background='var(--cashm)'; this.style.color='var(--navy)'"
             onmouseout="this.style.background='var(--navy)'; this.style.color='var(--cream)'">
            Aplicar →
          </a>
        </div>

        <div class="o5-offer-row border-t py-8 md:py-12 grid grid-cols-[40px_1fr] md:grid-cols-[80px_1fr_auto] gap-4 md:gap-8 items-start md:items-center o5-reveal"
             style="border-color: rgba(27,38,59,0.1);">
          <p class="text-4xl md:text-6xl"
             style="font-family: 'Playfair Display', serif; color: rgba(27,38,59,0.07); line-height: 1; font-weight: 700;">02</p>
          <div>
            <h3 class="text-xl md:text-3xl mb-3 md:mb-4"
                style="font-family: 'Playfair Display', serif; color: var(--navy);">
              Neurociencias Aplicadas a la Regulación Emocional
            </h3>
            <p class="leading-relaxed text-sm md:text-base" style="color: rgba(42,42,42,0.55);">
              Prácticas para dominar la biología del enfoque con el objetivo de lograr estabilidad emocional bajo presión.
            </p>
          </div>
          <a href="#contacto"
             class="hidden md:block whitespace-nowrap text-xs tracking-[0.2em] uppercase px-6 py-4 transition-colors duration-300"
             style="background: var(--cashm); color: var(--navy); margin-right: 1.5rem;"
             onmouseover="this.style.background='var(--navy)'; this.style.color='var(--cream)'"
             onmouseout="this.style.background='var(--cashm)'; this.style.color='var(--navy)'">
            Aplicar →
          </a>
        </div>

        <div class="o5-offer-row border-t py-8 md:py-12 grid grid-cols-[40px_1fr] md:grid-cols-[80px_1fr_auto] gap-4 md:gap-8 items-start md:items-center o5-reveal"
             style="border-color: rgba(27,38,59,0.1);">
          <p class="text-4xl md:text-6xl"
             style="font-family: 'Playfair Display', serif; color: rgba(27,38,59,0.07); line-height: 1; font-weight: 700;">03</p>
          <div>
            <h3 class="text-xl md:text-3xl mb-3 md:mb-4"
                style="font-family: 'Playfair Display', serif; color: var(--navy);">
              Cambio de Hábitos de Alto Rendimiento
            </h3>
            <p class="leading-relaxed text-sm md:text-base" style="color: rgba(42,42,42,0.55);">
              Sincronizamos la arquitectura mental con la emocional para consolidar una disciplina de alto impacto.
            </p>
          </div>
          <a href="#contacto"
             class="hidden md:block whitespace-nowrap text-xs tracking-[0.2em] uppercase px-6 py-4 transition-colors duration-300"
             style="background: var(--navy); color: var(--cream); margin-right: 1.5rem;"
             onmouseover="this.style.background='var(--cashm)'; this.style.color='var(--navy)'"
             onmouseout="this.style.background='var(--navy)'; this.style.color='var(--cream)'">
            Aplicar →
          </a>
        </div>

        <div class="border-t" style="border-color: rgba(27,38,59,0.1);"></div>

      </div>
    </section>

    <!-- ── Pilares (option 4 orb circles + hover animation) ── -->
    <section class="py-16 md:py-32 px-4 md:px-20" style="background: var(--navy);">
      <div class="max-w-5xl mx-auto">

        <div class="text-center mb-16 o5-reveal">
          <p class="text-xs tracking-[0.4em] uppercase mb-4" style="color: var(--cashm);">Cómo se trabaja</p>
          <h2 style="font-family: 'Playfair Display', serif; color: var(--cream); line-height: 1; display: flex; align-items: baseline; justify-content: center; gap: 0.3em;">
            <span style="font-size: clamp(4rem, 8vw, 7rem); font-weight: 700; line-height: 1;">3</span>
            <em style="font-size: clamp(2.5rem, 4vw, 3.5rem); color: rgba(245,242,235,0.4);">Pilares.</em>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16 relative">
          <div class="hidden md:block absolute top-12 left-[8%] right-[8%] h-px"
               style="background: rgba(245,242,235,0.07);"></div>

          {[
            {
              step: "01",
              title: "Reprogramación Mental Subconsciente",
              desc: "No analizamos el síntoma. Reprogramamos el patrón que lo genera y lo cambiamos de raíz."
            },
            {
              step: "02",
              title: "Neurociencias Aplicadas a la Regulación Emocional",
              desc: "Prácticas para dominar la biología del enfoque con el objetivo de lograr estabilidad emocional bajo presión."
            },
            {
              step: "03",
              title: "Cambio de Hábitos de Alto Rendimiento",
              desc: "Sincronizamos la arquitectura mental con la emocional para consolidar una disciplina de alto impacto."
            }
          ].map(item => (
            <div class="o5-pilar-card o5-reveal flex flex-col items-center text-center">
              <div class="o5-pilar-circle w-24 h-24 rounded-full border flex items-center justify-center mb-8"
                   style="border-color: rgba(215,201,180,0.22); background: var(--navy); color: var(--cashm); font-family: 'Playfair Display', serif; font-size: 1.5rem;">
                {item.step}
              </div>
              <h3 class="text-xl md:text-2xl mb-4 leading-snug px-2"
                  style="font-family: 'Playfair Display', serif; color: var(--cashm);">
                {item.title}
              </h3>
              <p class="o5-pilar-desc text-sm leading-loose max-w-xs"
                 style="color: rgba(245,242,235,0.5);">{item.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <div class="o5-sep mx-4 md:mx-20"
         style="border-top: 1px solid rgba(245,242,235,0.08);"></div>

    <!-- ── Sobre Mí + Resultados (option 3 2-col format) ─────── -->
    <section id="sobre-mi" class="relative py-16 md:py-32 px-4 md:px-20 overflow-hidden">
      <!-- Texture background with navy overlay (same file as option 3) -->
      <div class="absolute inset-0 z-0">
        <img src="/decorative-abstract.png" alt=""
             class="w-full h-full object-cover"
             style="opacity: 0.65;" />
        <div class="absolute inset-0"
             style="background: rgba(27,38,59,0.72);"></div>
      </div>

      <div class="relative z-10 max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-start">

        <!-- Left: bio -->
        <div class="o5-sobre-left">
